# Finlytics environment variables
# Copy this file to ".env" (same folder) and fill in real values.
# The .env file is gitignored and must NEVER be committed.

# --- Supabase (Phase 1) ---
# From your Supabase project: Settings -> API
# "Project URL"
VITE_SUPABASE_URL=

# "Project API keys" -> "anon" / "public"
VITE_SUPABASE_ANON_KEY=

# --- Email delivery via Resend (Phase 7 - not needed yet) ---
# RESEND_API_KEY=

# --- WhatsApp Business Cloud API (Phase 7 - behind a feature flag, not needed yet) ---
# WHATSAPP_ENABLED=false
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
