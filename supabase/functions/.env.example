# Local Edge Function env — copy to "supabase/functions/.env" (gitignored) for
# `supabase functions serve`. In production these are set with
# `supabase secrets set KEY=VALUE` instead (see supabase/DEPLOY.md).

# Resend (https://resend.com → API Keys). Free tier, no card.
RESEND_API_KEY=
# Verified sender. For testing you may use: Finlytics <onboarding@resend.dev>
RESEND_FROM=Finlytics <onboarding@resend.dev>

# Optional. Where reminders/reports are sent. Leave blank to use the signed-in
# account's own email (the usual case for this single-user app).
REPORT_RECIPIENT_EMAIL=

# Shared secret the pg_cron jobs send in the x-cron-secret header.
# Generate any long random string.
CRON_SECRET=

# WhatsApp — leave disabled for now (email-only).
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=

# Provided automatically by the platform in production; only needed locally:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
